{
  "name": "message",
  "target": "branch",
  "source_type": "Enterprise",
  "source": "enterprise_name",
  "enforcement": "active",
  "conditions": {
    "organization_name": {
      "exclude": [],
      "include": ["~ALL"]
    },
    "repository_name": {
      "exclude": [],
      "include": ["~ALL"]
    },
    "ref_name": {
      "exclude": [],
      "include": ["~ALL"]
    }
  },
  "rules": [
    {
      "type": "commit_message_pattern",
      "parameters": {
        "operator": "regex",
        "pattern": "^\\w+:.*",
        "negate": false,
        "name": ""
      }
    }
  ],
  "bypass_actors": [
    {
      "actor_id": null,
      "actor_type": "OrganizationAdmin",
      "bypass_mode": "always"
    },
    {
      "actor_id": 5,
      "actor_type": "RepositoryRole",
      "bypass_mode": "always"
    }
  ]
}
