{
  "name": "agent",
  "target": "push",
  "source_type": "Enterprise",
  "source": "enterprise_name",
  "enforcement": "active",
  "conditions": {
    "organization_name": {
      "exclude": [],
      "include": ["~ALL"]
    },
    "repository_name": {
      "exclude": [],
      "include": ["~ALL"]
    }
  },
  "rules": [
    {
      "type": "file_path_restriction",
      "parameters": {
        "restricted_file_paths": [
          ".github/agents/*.md",
          "agents/*.md",
          "AGENTS.md"
        ]
      }
    }
  ],
  "bypass_actors": [
    {
      "actor_id": null,
      "actor_type": "EnterpriseOwner",
      "bypass_mode": "always"
    }
  ]
}
