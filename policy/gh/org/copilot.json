{
  "name": "copilot",
  "target": "branch",
  "source_type": "Enterprise",
  "source": "enterprise_name",
  "enforcement": "active",
  "conditions": {
    "organization_name": {
      "exclude": [],
      "include": ["~ALL"]
    },
    "repository_name": {
      "exclude": [],
      "include": ["~ALL"]
    },
    "ref_name": {
      "exclude": [],
      "include": ["~ALL"]
    }
  },
  "rules": [
    {
      "type": "copilot_code_review",
      "parameters": {
        "review_on_push": true,
        "review_draft_pull_requests": false
      }
    }
  ],
  "bypass_actors": [
    {
      "actor_id": null,
      "actor_type": "OrganizationAdmin",
      "bypass_mode": "always"
    },
    {
      "actor_id": 5,
      "actor_type": "RepositoryRole",
      "bypass_mode": "always"
    }
  ]
}
